<script client>
import type { ConversationSummary } from '../../app/Attic/agent'
import { attachmentKind, desktop, nativeApi, nativeCraft, nativeDate, nativeEvents, nativePost, SOURCE_NAMES, SOURCE_SYMBOLS } from '../functions/native-attic'
import { isMine, TAPBACKS } from '../functions/tapbacks'

const view = state('inbox')
const scheme = state(nativeCraft().appearance.colorScheme())
const source = state('all')
const sources = state([])
const rows = state<ConversationSummary[]>([])
const selectedKey = state('')
const detail = state(null)
const messages = state([])
const localSends = state([])
const transcriptMessages = derived(() => [...messages(), ...localSends().filter(m => m.key === selectedKey())])
const hasEarlier = state(false)
const loading = state(true)
const access = state('granted')
const fixture = state(false)
const busy = state(false)
const flash = state('')
const query = state('')
const searchTerm = derived(() => query().trim())
const results = state([])
const searchState = state('idle')
const draft = state('')
const replyTo = state(null)
const outgoing = state([])
const connecting = state('')
const showConnectionOptions = state(false)
const token = state('')
const appToken = state('')
const account = state('user')
const discordUser = state('')
const whatsapp = state(null)
const qrImage = state('')
const workspaces = state([])
const rowLimit = state(120)
const shownRows = derived(() => rows().slice(0, rowLimit()))
const listTitle = derived(() => searchTerm() ? 'Search' : view() === 'archived' ? 'Archive' : view() === 'deleted' ? 'Recently Deleted' : source() === 'all' ? 'Inbox' : SOURCE_NAMES[source()] ?? 'Inbox')
const selectedNav = derived(() => view() !== 'inbox' ? view() : source() === 'all' ? 'all' : `source:${source()}`)
const sourceColors = { imessage: '#0088ff', whatsapp: '#19b963', slack: '#df3675', discord: '#7567f7' }
const palette = derived(() => ({ selection:scheme() === 'dark' ? '#215b9a' : '#195eae', text:scheme() === 'dark' ? '#f4f4f6' : '#1d1d1f', muted:scheme() === 'dark' ? '#adaeb3' : '#62646b' }))
function listItem(c) { return { ...c, timestamp:nativeDate(c.lastMessageAt), preview:c.preview || '', sourceSymbol:sourceSymbol(c), sourceColor:sourceColors[c.provider] } }
function sourceSymbol(c) { return source() === 'all' ? SOURCE_SYMBOLS[c.provider] : null }
const connectedSources = derived(() => sources().filter(s => s.status.connected))
const sidebarSections = derived(() => {
  const items = [{ id: 'all', label: 'Inbox', icon: 'tray' }, { id: 'archived', label: 'Archive', icon: 'archivebox' }]
  if (view() === 'deleted') items.push({ id: 'deleted', label: 'Recently Deleted', icon: 'trash' })
  const sections = [{ id: 'mailboxes', items }]
  if (connectedSources().length) sections.push({ id: 'sources', header: 'Sources', items: connectedSources().map(s => ({ id: `source:${s.provider}`, label: s.label, icon: SOURCE_SYMBOLS[s.provider], color:sourceColors[s.provider] })) })
  return sections
})
const canSend = derived(() => !!detail() && !!sources().find(s => s.provider === detail().provider)?.capabilities?.send)
let selectionRequest = 0

function say(text) {
  flash.set(text)
  setTimeout(() => flash() === text && flash.set(''), 5000)
}

async function loadStatus() {
  const status = await nativeApi('/api/status')
  sources.set(status.sources)
  access.set(status.access)
  fixture.set(status.fixture)
}

async function loadLists() {
  const mailbox = view()
  const provider = source()
  const list = (name, filter) => nativeApi(`/api/conversations?view=${name}&source=${filter}`)
  const allInbox = list('inbox', 'all')
  const [inbox, visible] = await Promise.all([allInbox, mailbox === 'inbox' && provider === 'all' ? allInbox : list(mailbox, provider)])
  if (view() !== mailbox || source() !== provider) return
  rows.set(visible)
  desktop().setBadge(inbox.filter(c => c.unread > 0).length)
}

async function select(key) {
  const request = ++selectionRequest
  if (selectedKey() !== key) {
    draft.set('')
    replyTo.set(null)
    outgoing.set([])
  }
  selectedKey.set(key)
  if (!key) {
    detail.set(null)
    messages.set([])
    return
  }
  try {
    const [info, transcript] = await Promise.all([nativeApi(`/api/conversation?key=${encodeURIComponent(key)}`), nativeApi(`/api/messages?key=${encodeURIComponent(key)}`)])
    if (request !== selectionRequest || selectedKey() !== key)
      return
    detail.set(info)
    const matched = new Set()
    localSends.set(localSends().filter((sent) => {
      if (sent.key !== key || sent.pending)
        return true
      const saved = transcript.messages.find(m => !matched.has(m.guid) && m.isFromMe && m.kind === 'message'
        && (sent.messageId ? m.guid === sent.messageId
          : m.sentAt >= sent.sentAt - 1000 && (m.text || '') === sent.body && (m.attachments?.length || 0) === sent.fileCount))
      if (saved)
        matched.add(saved.guid)
      return !saved
    }))
    messages.set(transcript.messages.filter(m => m.kind !== 'reaction'))
    hasEarlier.set(transcript.hasEarlier)
    await nativeCraft().storage.set('selected', key)
    if (info.unread && sources().find(s => s.provider === info.provider)?.capabilities?.markRead)
      await nativePost('/api/read', { key })
  }
  catch (error) { say(error.message) }
}

async function refresh() {
  try {
    await loadStatus()
    await loadLists()
    await select(rows().some(c => c.key === selectedKey()) ? selectedKey() : rows()[0]?.key ?? '')
  }
  catch (error) { say(error.message) }
  finally { loading.set(false) }
}

async function show(next, provider = 'all') {
  view.set(next)
  source.set(provider)
  query.set('')
  rowLimit.set(120)
  await loadLists()
  if (view() === next && source() === provider) await select(rows()[0]?.key ?? '')
}

async function pickNav(id) {
  if (id === 'archived' || id === 'deleted') { await show(id); return }
  const provider = id === 'all' ? 'all' : id.slice('source:'.length)
  await show('inbox', provider)
}

function openMessagesAccess() {
  return nativeCraft().openURL('x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles')
}

async function sourceMenu() {
  try {
    const options = sources()
      .filter(s => !s.status.connected || s.provider === 'slack')
      .map(s => ({ id: s.provider, title: s.status.connected ? 'Manage Slack Workspaces…' : s.provider === 'imessage' ? 'Allow Messages Access…' : `Connect ${s.label}…`, icon: SOURCE_SYMBOLS[s.provider] }))
    if (!options.length) return
    const provider = await desktop().contextMenu(options)
    if (provider === 'imessage') await openMessagesAccess()
    else if (provider) await connect(provider)
  }
  catch (error) { say(error.message) }
}

function openSettings() {
  desktop().openWindow({ name: 'settings', route: 'Settings', title: 'Settings', width: 740, height: 560, minWidth: 670, minHeight: 440 })
}

async function archive(key = selectedKey()) {
  if (!key || busy()) return
  busy.set(true)
  try {
    const result = await nativePost('/api/archive', { key })
    if (!result.verified) { say('Not every message could be copied. The conversation stays in the Inbox.'); return }
    await loadLists()
    await select(rows()[0]?.key ?? '')
    say(`${result.messages} messages kept. ${result.app?.detail ?? ''}`)
  }
  catch (error) { say(error.message) }
  finally { busy.set(false) }
}

async function unarchive(key = selectedKey()) {
  if (!key || busy()) return
  busy.set(true)
  try { await nativePost('/api/unarchive', { key }); await refresh(); say('Moved back to the Inbox.') }
  catch (error) { say(error.message) }
  finally { busy.set(false) }
}

/**
 * Write the conversation, or everything Texts kept, out as pages anyone can
 * read. The agent reveals the folder in the Finder when it is done, so the
 * window only has to say what was written and where.
 */
async function exportKept(key = null) {
  if (busy()) return
  busy.set(true)
  say(key ? 'Exporting this conversation…' : 'Exporting the archive…')
  try {
    const result = await nativePost('/api/export', key ? { key } : {})
    const what = key ? `${result.messages} messages` : `${result.conversations.length} conversations`
    say(`Exported ${what} to ${result.folder}.${result.missingAttachments ? ` ${result.missingAttachments} attachments were already gone.` : ''}`)
  }
  catch (error) { say(error.message) }
  finally { busy.set(false) }
}

async function openInApp(key = selectedKey()) {
  try { await nativePost('/api/open', { key }) }
  catch (error) { say(error.message) }
}

async function rowMenu(c) {
  if (!c) return
  if (selectedKey() !== c.key) await select(c.key)
  const choice = await desktop().contextMenu([
    { id: c.state === 'archived' ? 'restore' : 'archive', title: c.state === 'archived' ? 'Move to Inbox' : 'Archive', icon: 'archivebox' },
    { id: 'always', title: 'Always Archive', icon: 'archivebox.circle', checked: !!c.rule, disabled: !!c.rule },
    { separator: true }, { id: 'open', title: `Show in ${SOURCE_NAMES[c.provider]}`, icon: 'arrow.up.forward.app', disabled: !c.url },
    { id: 'export', title: 'Export…', icon: 'square.and.arrow.up', disabled: !c.saved },
    ...(c.saved ? [{ separator: true }, { id: 'forget', title: 'Delete Local Copy…', icon: 'trash' }] : []),
  ])
  if (choice === 'archive') await archive(c.key)
  if (choice === 'restore') await unarchive(c.key)
  if (choice === 'open') await openInApp(c.key)
  if (choice === 'export') await exportKept(c.key)
  if (choice === 'always') { await nativePost('/api/rules/for-conversation', { key: c.key }); say('Always archive is on for this conversation.'); await refresh() }
  if (choice === 'forget' && await nativeCraft().dialog.confirm({ title: 'Delete the local copy?', message: 'This removes the saved messages and attachments from Texts. It leaves the original app alone.', confirmLabel: 'Delete', cancelLabel: 'Cancel', destructive: true })) {
    await nativePost('/api/forget', { key: c.key }); await refresh()
  }
}

async function loadEarlier() {
  if (!messages().length) return
  const key = selectedKey()
  const transcript = await nativeApi(`/api/messages?key=${encodeURIComponent(key)}&before=${messages()[0].sentAt}`)
  if (key === selectedKey()) { messages.set([...transcript.messages, ...messages()]); hasEarlier.set(transcript.hasEarlier) }
}

async function messageMenu(m) {
  if (m.local)
    return
  const caps = sources().find(s => s.provider === detail()?.provider)?.capabilities ?? {}
  const choice = await desktop().contextMenu([
    ...(caps.replies ? [{ id: 'reply', title: 'Reply', icon: 'arrowshape.turn.up.left' }] : []),
    ...(caps.reactions ? TAPBACKS.map(r => ({ id: `react:${r.emoji}`, title: `${r.emoji} ${r.label}`, checked: isMine(m.reactions, r.emoji) })) : []),
    ...(m.text ? [{ id: 'copy', title: 'Copy', icon: 'doc.on.doc' }] : []),
  ])
  if (choice === 'copy') await nativeCraft().clipboard.write(m.text)
  if (choice === 'reply') { replyTo.set(m); await desktop().focus('composer') }
  if (choice?.startsWith('react:')) {
    const reaction = choice.slice(6)
    await nativePost('/api/react', { key: selectedKey(), messageId: m.guid, reaction, remove: isMine(m.reactions, reaction) })
    await select(selectedKey())
  }
}

async function previewAttachment(a) {
  if (!a.available) { say('This attachment has not been downloaded.'); return }
  const type = attachmentKind(a.mimeType)
  if (type === 'file') await desktop().exportFile({ url: a.url, name: a.name })
  else await desktop().preview({ url: a.url, title: a.name, type })
}

async function attachFiles() {
  const files = await desktop().pickFiles()
  if (!files.length) return
  const uploaded = await desktop().uploadFiles(files, new URL('/api/upload', nativeCraft().app.url).href)
  if (uploaded.error) { say(uploaded.error); return }
  outgoing.set([...outgoing(), ...uploaded])
}

async function sendDraft() {
  const text = draft().trim()
  const files = outgoing()
  if (!detail() || !canSend() || busy() || (!text && !files.length)) return
  const key = selectedKey()
  const reply = replyTo()
  const sentAt = Date.now()
  const guid = `pending-${sentAt}`
  const pending = {
    key, guid, sentAt, local: true, pending: true, isFromMe: true, kind: 'message',
    text: text || files.map(file => file.name).join(', '), body: text, fileCount: files.length,
    attachments: [], reactions: [], replyToGuid: reply?.guid ?? null, service: messages().at(-1)?.service ?? null,
  }
  localSends.set([...localSends(), pending])
  draft.set(''); outgoing.set([]); replyTo.set(null)
  busy.set(true)
  try {
    const result = await nativePost('/api/send', { key, text, files, replyToId: reply?.guid ?? null })
    localSends.set(localSends().map(m => m.guid === guid ? { ...m, pending: false, messageId: result.id } : m))
    if (selectedKey() === key)
      void select(key)
  }
  catch (error) {
    localSends.set(localSends().filter(m => m.guid !== guid))
    if (selectedKey() === key && !draft() && !outgoing().length) {
      draft.set(text); outgoing.set(files); replyTo.set(reply)
    }
    say(error.message)
  }
  finally { busy.set(false) }
}

async function connect(provider) {
  connecting.set(provider); token.set(''); appToken.set(''); discordUser.set(''); qrImage.set('')
  showConnectionOptions.set(false)
  workspaces.set([])
  whatsapp.set(null)
  if (provider === 'whatsapp') {
    whatsapp.set(await nativePost('/api/whatsapp/link'))
    await updateQR()
  }
  if (provider === 'slack') {
    const { workspaces: list } = await nativeApi('/api/slack/workspaces')
    if (connecting() === provider) workspaces.set(list)
  }
}

async function updateQR() {
  const qr = whatsapp()?.qr
  if (qr) qrImage.set(await desktop().qrCode(qr))
}

async function connectToken() {
  try {
    await nativePost('/api/sources/connect', { provider: connecting(), token: token(), appToken: appToken(), account: account(), userId: discordUser() })
    connecting.set(''); token.set(''); appToken.set(''); await refresh()
  }
  catch (error) { say(error.message) }
}

async function disconnect(provider, teamId = null) {
  await nativePost('/api/sources/disconnect', { provider, teamId }); await refresh()
  if (provider === 'slack') workspaces.set((await nativeApi('/api/slack/workspaces')).workspaces)
}

async function openCleanup() {
  try {
    await desktop().openWindow({ name: 'cleanup', route: 'Cleanup', title: 'Clean Up', titlebarStyle: 'standard', width: 460, height: 330, minWidth: 420, minHeight: 310, params: { source: source() } })
  }
  catch (error) { say(error.message) }
}

function move(delta) { const index = rows().findIndex(c => c.key === selectedKey()); select(rows()[Math.max(0, Math.min(rows().length - 1, index + delta))]?.key ?? '') }

let searchTimer
let searchRequest = 0
effect(() => {
  const text = searchTerm()
  const request = ++searchRequest
  clearTimeout(searchTimer)
  results.set([])
  searchState.set(text ? 'loading' : 'idle')
  if (!text) return
  searchTimer = setTimeout(async () => {
    try {
      const hits = await nativeApi(`/api/search?q=${encodeURIComponent(text)}`)
      if (request !== searchRequest) return
      results.set(hits)
      searchState.set('ready')
    }
    catch {
      if (request === searchRequest) searchState.set('error')
    }
  }, 180)
})
onDestroy(() => { searchRequest++; clearTimeout(searchTimer) })

async function openResult(hit) {
  source.set('all'); query.set(''); await select(hit.conversationKey)
  view.set(detail()?.state === 'archived' ? 'archived' : detail()?.state === 'deleted' ? 'deleted' : 'inbox')
  await loadLists()
}

onMount(async () => {
  onDestroy(nativeEvents(async event => {
    if (event.type === 'whatsapp') { whatsapp.set(event.link); await updateQR(); if (event.link.phase === 'open') { connecting.set(''); await refresh() } }
    if (['changed', 'settings', 'sources', 'access'].includes(event.type)) await refresh()
    if (event.type === 'incoming') {
      if (selectedKey() === event.key)
        void select(event.key)
      if (!nativeCraft().navigation.isFocused())
        await nativeCraft().notifications.show({ id: `attic-${event.key}-${event.at}`, title: event.title, body: event.text })
    }
  }))
  await refresh()
  const remembered = await nativeCraft().storage.get('selected')
  if (rows().some(c => c.key === remembered)) await select(remembered)
  onDestroy(desktop().onCommand(id => {
    if (id === 'appearance') scheme.set(nativeCraft().appearance.colorScheme())
    if (id === 'settings') openSettings()
    if (id === 'archive') archive()
    if (id === 'restore') unarchive()
    if (id === 'inbox') show('inbox')
    if (id === 'archived') show('archived')
    if (id === 'deleted') show('deleted')
    if (id === 'find') desktop().focus('search')
    if (id === 'next') move(1)
    if (id === 'previous') move(-1)
    if (id === 'open') openInApp()
    if (id === 'cleanup') openCleanup()
    if (id === 'export') exportKept(selectedKey())
    if (id === 'export-all') exportKept()
  }))
  await desktop().setMenus([
    { label: 'Conversation', items: [{ id: 'archive', label: 'Archive', shortcut: 'ctrl+cmd+a' }, { id: 'restore', label: 'Move to Inbox', shortcut: 'shift+cmd+u' }, { id: 'open', label: 'Show in App', shortcut: 'cmd+o' }, { separator: true }, { id: 'export', label: 'Export…', shortcut: 'shift+cmd+e' }, { id: 'export-all', label: 'Export Everything…' }] },
    { label: 'View', items: [{ id: 'inbox', label: 'Inbox', shortcut: 'cmd+1' }, { id: 'archived', label: 'Archived', shortcut: 'cmd+2' }, { id: 'deleted', label: 'Recently Deleted', shortcut: 'cmd+3' }, { separator: true }, { id: 'find', label: 'Find', shortcut: 'cmd+f' }, { id: 'next', label: 'Next Conversation', shortcut: 'cmd+down' }, { id: 'previous', label: 'Previous Conversation', shortcut: 'cmd+up' }, { id: 'cleanup', label: 'Clean Up…' }] },
  ])
})
</script>

<View class="flex-1 flex-row" testID="main-shell">
  <AtticSidebar :sections="sidebarSections()" :selected="selectedNav()" :fixture="fixture()" @choose="pickNav($event)" @sources="sourceMenu()" @settings="openSettings()" />
  <View class="flex-col shrink-0 w-[328px] border-r" :style="{borderColor:'separator',backgroundColor:scheme() === 'dark' ? '#202022' : '#fafafb'}" testID="inbox-pane">
    <View class="flex-row gap-2 items-center justify-between px-4 h-[54px]">
      <Text class="flex-1 font-semibold text-[19px]" :text="listTitle()" testID="mailbox-title" />
      <ToolbarButton label="Clean Up…" symbol="archivebox.circle" testID="cleanup" @click="openCleanup()" />
    </View>
    <View class="pb-3 px-4"><TextInput type="search" class="h-[28px] text-[13px]" placeholder="Search messages" x-model="query" testID="search" /></View>
    <Text :if="loading()" class="p-4 text-[12px]" style="color: secondaryLabel" :text="'Loading conversations…'" />
    <View :if="!loading() && !rows().length && !searchTerm()" class="gap-1 px-5 py-4">
      <Text class="font-medium text-[13px]" :text="view() === 'archived' ? 'No archived conversations' : view() === 'deleted' ? 'No recently deleted conversations' : 'Your inbox is empty'" />
      <Text :if="view() === 'archived'" class="text-[12px]" style="color: secondaryLabel" :text="'Conversations you archive appear here.'" />
    </View>
    <ScrollView class="flex-1" testID="conversation-list">
      <View :if="!searchTerm()" class="gap-[3px] pb-3 px-2">
        <ConversationListItem :for="c in shownRows()" :key="c.key" :item="listItem(c)" :selected="c.key === selectedKey()" :palette="palette()" :testID="`row-${c.key}`" @choose="select(c.key)" @menu="rowMenu(c)" />
        <Button :if="rows().length > rowLimit()" title="More conversations" variant="ghost" @click="rowLimit.set(rowLimit()+120)" />
      </View>
      <View :if="searchTerm()" class="gap-[3px] pb-3 px-2">
        <Text :if="!results().length" class="px-3 py-4 text-[12px]" style="color: secondaryLabel" :text="searchState() === 'loading' ? 'Searching…' : searchState() === 'error' ? 'Search failed. Try again.' : 'No matching messages.'" testID="search-status" />
        <ConversationListItem :for="hit in results()" :key="hit.guid" :item="{title:hit.title,preview:hit.snippet.replace(/[\u0001\u0002]/g, ''),initials:hit.title.slice(0,2).toUpperCase()}" :palette="palette()" :testID="`result-${hit.guid}`" @choose="openResult(hit)" />
      </View>
    </ScrollView>
  </View>
  <View class="flex-1 flex-col min-w-0" :style="{backgroundColor:scheme() === 'dark' ? '#1e1e20' : '#ffffff'}" testID="transcript-pane">
    <View :if="!detail() && !loading()" class="flex-1 gap-3 items-center justify-center p-8">
      <Icon symbol="bubble.left.and.bubble.right" class="h-[30px] w-[30px]" style="color: secondaryLabel" />
      <Text class="font-medium text-[16px]" :text="connectedSources().length ? 'Choose a conversation' : 'Connect a source to get started'" />
      <Button :if="!connectedSources().length && access() === 'needs-full-disk-access'" title="Allow Messages Access…" @click="openMessagesAccess()" />
      <Button :if="!connectedSources().length && access() !== 'needs-full-disk-access'" title="Add a Source…" @click="sourceMenu()" />
    </View>
    <AtticConversationHeader :if="detail()" :conversation="detail()" :busy="busy()" @archive="archive()" @restore="unarchive()" @menu="rowMenu(detail())" />
    <AtticTranscript :if="detail()" :messages="transcriptMessages()" :conversation="detail()" :earlier="hasEarlier()" :dark="scheme() === 'dark'" @earlier="loadEarlier()" @message-menu="messageMenu($event)" @attachment="previewAttachment($event)" />
    <AtticComposer :if="detail()" v-model:draft="draft" :enabled="canSend()" :canOpen="!!detail().url" :busy="busy()" :provider="detail().provider" :reply="replyTo()" :files="outgoing()" @send="sendDraft()" @attach="attachFiles()" @open="openInApp()" @cancel-reply="replyTo.set(null)" @remove-file="outgoing.set(outgoing().filter(f => f.path !== $event.path))" />
    <Text :if="flash()" class="px-5 py-2 text-[12px] border-t" style="color: secondaryLabel; border-color: separator" :text="flash()" testID="status-message" />
  </View>
  <Modal :if="connecting()" :visible="true" :title="`Connect ${SOURCE_NAMES[connecting()]}`" @close="connecting.set('')" testID="connect-dialog">
    <View class="gap-4 p-6">
      <View :if="connecting() === 'whatsapp'" class="gap-3">
        <Text style="color: secondaryLabel" :text="'In WhatsApp on your phone, open Settings, then Linked Devices.'" />
        <Image :if="qrImage()" :source="qrImage()" class="h-[208px] w-[208px]" accessibilityLabel="WhatsApp pairing code" />
        <Text :if="!qrImage()" :text="whatsapp()?.error || 'Preparing the pairing code…'" />
      </View>
      <View :if="connecting() !== 'whatsapp'" class="gap-2">
        <Picker :if="connecting() === 'discord'" x-model="account" :options="[{value:'user',label:'User account'},{value:'bot',label:'Bot account'}]" accessibilityLabel="Discord account type" />
        <TextInput type="password" :placeholder="connecting() === 'slack' ? 'Slack User OAuth token' : 'Discord token'" x-model.trim="token" testID="source-token" accessibilityLabel="Account token" />
        <Button :title="showConnectionOptions() ? 'Hide Advanced Options' : 'Advanced Options…'" variant="ghost" @click="showConnectionOptions.set(!showConnectionOptions())" testID="source-options" />
        <View :if="showConnectionOptions()" class="gap-2">
          <TextInput :if="connecting() === 'slack'" type="password" placeholder="App-level token for live updates" x-model.trim="appToken" accessibilityLabel="Slack app-level token" />
          <TextInput :if="connecting() === 'discord'" placeholder="Discord user ID (optional)" x-model.trim="discordUser" accessibilityLabel="Discord user ID" />
        </View>
      </View>
      <View :if="workspaces().length" class="gap-2">
        <Text class="font-medium" :text="'Connected Workspaces'" />
        <Button :for="workspace in workspaces()" :key="workspace.teamId" :title="`Sign out of ${workspace.team}`" @click="disconnect('slack', workspace.teamId)" />
      </View>
      <View class="flex-row gap-2 justify-end">
        <Button :title="connecting() === 'whatsapp' ? 'Done' : 'Cancel'" @click="connecting.set('')" />
        <Button :if="connecting() !== 'whatsapp'" title="Connect" variant="primary" :disabled="!token().trim()" @click="connectToken()" />
      </View>
    </View>
  </Modal>
</View>
