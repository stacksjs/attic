<script client>
import { componentApi } from '@stacksjs/components/component-api'
import { desktop, nativeApi, nativeCraft, nativeDate, nativeEvents, nativePost, SOURCE_NAMES } from '../functions/native-attic'
import { pairingLink } from '../functions/sealed'

const resurface = state('inbox')
const removal = state('auto')
const accessible = state(true)
const rules = state([])
const phones = state([])
const pairing = state(null)
const qr = state('')
const note = state('')
const version = state('')
const update = state(null)
const loaded = state(false)
const saving = state(false)
const preparingPairing = state(false)
const paired = derived(() => phones().find(p => p.id === pairing()?.pairing?.device && p.lastSeenAt))
let phoneRequest = 0

async function loadUpdate() {
  try { update.set(await nativeApi('/api/updates')) }
  catch (error) { note.set(error.message) }
}

async function updateApp(action) {
  try {
    const result = await nativePost(`/api/updates/${action}`)
    if (action !== 'relaunch') update.set(result)
  }
  catch (error) { note.set(error.message) }
}

async function loadPreferences() {
  try {
    const status = await nativeApi('/api/status')
    if (!saving()) {
      resurface.set(status.settings.resurface)
      removal.set(status.settings.removal)
    }
    accessible.set(status.accessibility !== false)
    version.set(status.version)
    loaded.set(true)
  }
  catch (error) { note.set(error.message) }
}

async function loadRules() {
  try { rules.set(await nativeApi('/api/rules')) }
  catch (error) { note.set(error.message) }
}

async function loadPhones() {
  const request = ++phoneRequest
  try {
    const { devices } = await nativeApi('/api/phone/devices')
    if (request === phoneRequest) phones.set(devices)
  }
  catch (error) { note.set(error.message) }
}

async function save(key, value) {
  if (saving()) return
  const preference = key === 'resurface' ? resurface : removal
  const previous = preference()
  saving.set(true)
  note.set('')
  preference.set(value)
  try {
    const result = await nativePost('/api/settings', { [key]: value })
    resurface.set(result.resurface)
    removal.set(result.removal)
  }
  catch (error) {
    preference.set(previous)
    note.set(error.message)
  }
  finally { saving.set(false) }
}

async function allowAccessibility() {
  try { accessible.set((await nativePost('/api/accessibility')).trusted) }
  catch (error) { note.set(error.message) }
}

async function stop(rule) {
  note.set('')
  try { rules.set((await nativePost('/api/rules/delete', { id: rule.id })).rules) }
  catch (error) { note.set(error.message) }
}

async function pairPhone() {
  if (preparingPairing()) return
  preparingPairing.set(true)
  try {
    const result = await nativePost('/api/phone/pair')
    if (result.error) { note.set(result.error); return }
    qr.set(await desktop().qrCode(pairingLink(result.pairing)))
    pairing.set(result)
    note.set('')
    await loadPhones()
  }
  catch (error) { note.set(error.message) }
  finally { preparingPairing.set(false) }
}

async function forget(phone) {
  try {
    if (!await nativeCraft().dialog.confirm({ title: `Forget ${phone.name}?`, message: 'This phone will no longer be able to reach the archive on this Mac.', confirmLabel: 'Forget', cancelLabel: 'Cancel' })) return
    await nativePost('/api/phone/forget', { id: phone.id })
    if (pairing()?.pairing?.device === phone.id) pairing.set(null)
    await loadPhones()
    note.set('')
  }
  catch (error) { note.set(error.message) }
}

onMount(() => {
  onDestroy(desktop().onCommand(id => {
    if (id === 'find') componentApi('attic-settings')?.focusSearch()
  }))
  onDestroy(nativeEvents(event => {
    if (event.type === 'update') update.set(event.status)
    if (event.type === 'settings' || event.type === 'access') return loadPreferences()
    if (event.type === 'changed') return loadRules()
    if (event.type === 'phones') return loadPhones()
  }))
  const timer = setInterval(() => { if (pairing() && !paired()) void loadPhones() }, 2000)
  onDestroy(() => clearInterval(timer))
  void Promise.all([loadPreferences(), loadRules(), loadPhones(), loadUpdate()])
})
</script>

<View class="flex-1 flex-col">
  <SettingsWindow id="attic-settings" title="Texts Settings" storageKey="attic">
    <template #sidebar>
      <SettingsSidebarGroup>
        <SettingsSidebarItem id="archiving" label="Archiving" symbol="archivebox.fill" tone="blue" />
        <SettingsSidebarItem id="rules" label="Always Archive" symbol="clock.fill" tone="indigo" />
        <SettingsSidebarItem id="phone" label="Phone Sync" symbol="iphone" tone="green" keywords="devices sync pairing" />
        <SettingsSidebarItem id="updates" label="Software Update" symbol="arrow.down.circle.fill" tone="blue" />
        <SettingsSidebarItem id="about" label="About" symbol="info.circle.fill" tone="grey" />
      </SettingsSidebarGroup>
    </template>

    <SettingsPane id="archiving" title="Archiving" active>
      <SettingsGroup footer="Automatic rules and Clean Up leave closed apps closed.">
        <SettingsRow label="When someone writes again" setting="resurface" keywords="inbox reply new message">
          <Picker class="w-[184px]" :value="resurface()" :disabled="saving() || !loaded()" :options="[{value:'inbox',label:'Move to Inbox'},{value:'stay',label:'Keep Archived'}]" @change="save('resurface', $event.nativeEvent.value)" testID="resurface" accessibilityLabel="When someone writes again" />
        </SettingsRow>
        <SettingsRow label="When you archive" setting="removal" keywords="delete remove messages whatsapp">
          <Picker class="w-[184px]" :value="removal()" :disabled="saving() || !loaded()" :options="[{value:'auto',label:'Remove from Source App'},{value:'confirm',label:'Confirm in Messages'},{value:'off',label:'Keep in Source App'}]" @change="save('removal', $event.nativeEvent.value)" testID="removal" accessibilityLabel="When you archive" />
        </SettingsRow>
      </SettingsGroup>
      <View :if="loaded() && removal() !== 'off' && !accessible()">
        <SettingsGroup>
          <SettingsRow label="Accessibility" description="Needed to remove chats from Messages and WhatsApp." setting="accessibility" multiline>
            <Button title="Allow" accessibilityLabel="Allow Accessibility" @click="allowAccessibility()" />
          </SettingsRow>
        </SettingsGroup>
      </View>
    </SettingsPane>

    <SettingsPane id="rules" title="Always Archive">
      <SettingsGroup footer="Choose Always Archive from a conversation’s actions.">
        <SettingsRow :if="!rules().length" label="No rules yet" />
        <SettingsRow :for="rule in rules()" :key="rule.id" :label="rule.label || rule.value" :description="`${rule.kind === 'person' ? 'Person' : 'Group'} on ${SOURCE_NAMES[rule.provider] || rule.provider}`">
          <Button title="Stop" @click="stop(rule)" :testID="`stop-${rule.id}`" />
        </SettingsRow>
      </SettingsGroup>
    </SettingsPane>

    <SettingsPane id="phone" title="Phone Sync">
      <SettingsGroup>
        <SettingsRow label="Pair a phone" description="Sync your archive over the same Wi-Fi." setting="pair-phone" keywords="sync device qr" multiline>
          <Button :title="pairing() && !paired() ? 'Close Code' : 'Pair…'" @click="pairing() && !paired() ? pairing.set(null) : pairPhone()" :disabled="preparingPairing()" testID="pair-phone" />
        </SettingsRow>
      </SettingsGroup>
      <View :if="pairing() && !paired()" class="gap-3 items-center p-3">
        <Image :source="qr()" class="h-[160px] w-[160px]" accessibilityLabel="Phone pairing code" />
        <Text class="text-[12px]" style="color: secondaryLabel" :text="'Scan this code with your phone.'" />
      </View>
      <View :if="phones().length">
        <SettingsGroup header="Paired Devices">
          <SettingsRow :for="phone in phones()" :key="phone.id" :label="phone.name" :description="phone.lastSeenAt ? `Last synced ${nativeDate(phone.lastSeenAt)}` : 'Not synced yet'">
            <Button title="Forget…" @click="forget(phone)" />
          </SettingsRow>
        </SettingsGroup>
      </View>
    </SettingsPane>

    <SettingsPane id="updates" title="Software Update">
      <SettingsGroup>
        <SettingsUpdateRow appName="Texts" :status="update()" @check="updateApp('check')" @install="updateApp('install')" @relaunch="updateApp('relaunch')" />
      </SettingsGroup>
    </SettingsPane>

    <SettingsPane id="about" title="About">
      <SettingsGroup>
        <SettingsRow label="Version" setting="version" keywords="build release">
          <Text :text="version()" testID="settings-version" />
        </SettingsRow>
      </SettingsGroup>
    </SettingsPane>
  </SettingsWindow>
  <Text :if="note()" class="px-4 py-2 text-[12px] border-t" style="color: secondaryLabel; border-color: separator" :text="note()" testID="settings-note" />
</View>
