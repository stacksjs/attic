<script server>
import pkg from '../../package.json'

const source = 'https://github.com/stacksjs/attic'
const releases = 'https://github.com/stacksjs/attic-downloads/releases/latest'
const download = `https://github.com/stacksjs/attic-downloads/releases/download/v${pkg.version}/Attic-${pkg.version}.dmg`

const channels = [
  { name: 'Messages', icon: 'i-hugeicons-message-01', body: 'Read iMessage and SMS conversations from Messages on your Mac.' },
  { name: 'WhatsApp', icon: 'i-hugeicons-whatsapp', body: 'Link WhatsApp to bring your chats into Attic.' },
  { name: 'Slack', icon: 'i-hugeicons-slack', body: 'Keep up with conversations in connected workspaces.' },
  { name: 'Discord', icon: 'i-hugeicons-discord', body: 'Connect a bot to read eligible server channels and threads.' },
]

const faqs = [
  { question: 'Where is my archive stored?', answer: 'Attic stores its archive on your Mac. If you set up phone sync, Attic can share your conversations with a paired device.' },
  { question: 'What happens when I archive a chat?', answer: 'Attic saves a local copy and moves the chat to its archive. Depending on the service and conversation, it can also archive, close, or remove the thread in the original app. Attic shows what it can do before you archive.' },
  { question: 'Can I move an archived chat back?', answer: 'You can bring a conversation back to your Attic inbox. Recovery in the original app depends on the service. For example, Messages recovery is available while the thread is in Recently Deleted.' },
  { question: 'Why does Attic ask for macOS permissions?', answer: 'Reading the local Messages history requires Full Disk Access. Attic asks for Accessibility when it needs to perform an action for you in an app such as Messages or WhatsApp.' },
  { question: 'How do updates work?', answer: 'Attic checks its public GitHub releases for updates. You can also open Updates in Attic Settings to check manually.' },
]
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Attic | A Mac inbox and archive for your chats</title>
  <meta name="description" content="Attic brings Messages, WhatsApp, Slack, and Discord together in one Mac inbox with a searchable local archive.">
  <meta property="og:title" content="Attic | A Mac inbox and archive for your chats">
  <meta property="og:description" content="Keep the chat. Clear the inbox. Attic is a Mac app for Messages, WhatsApp, Slack, and Discord.">
  <meta property="og:image" content="https://attic.stacksjs.com/images/screens/attic-inbox-light.webp">
  <link rel="canonical" href="https://attic.stacksjs.com/">
  <link rel="icon" href="/images/app-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&amp;family=Newsreader:opsz,wght@6..72,400..600&amp;display=swap">
  <style>
    :root {
      color-scheme: light dark;
      --paper: #fcf9f4;
      --ink: #241d18;
      --muted: #63564d;
      --line: #ded3c8;
      --accent: #9f3825;
      --action: #a33b28;
      --action-hover: #862d1e;
      --action-ink: #fffaf4;
      --frame: #eaded1;
      --halo: #eab79970;
      --panel: #f4ebe1;
      --shadow: #3722162e;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #1f1916;
        --ink: #faf0e6;
        --muted: #c6b5a7;
        --line: #544339;
        --accent: #ffae95;
        --action: #ffb39b;
        --action-hover: #ffcab6;
        --action-ink: #33170f;
        --frame: #49372e;
        --halo: #8c3c2860;
        --panel: #2a211d;
        --shadow: #0007;
      }
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-padding-top: 1.25rem; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1rem/1.6 'Geist', system-ui, sans-serif; }
    a { color: inherit; text-underline-offset: .25em; }
    a, summary { -webkit-tap-highlight-color: transparent; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: .25rem; }
    img { display: block; max-width: 100%; height: auto; }
    h1, h2, h3, p, figure { margin: 0; }
    .wrap { width: min(78rem, calc(100% - clamp(2rem, 8vw, 9rem))); margin-inline: auto; }
    .skip { position: absolute; top: .75rem; left: .75rem; padding: .6rem 1rem; background: var(--paper); z-index: 2; transform: translateY(-200%); }
    .skip:focus { transform: translateY(0); }
    .header { min-height: 5rem; padding-block: .8rem; border-bottom: 1px solid var(--line); }
    .brand { color: var(--ink); font-weight: 650; letter-spacing: -.04em; font-size: 1.2rem; text-decoration: none; white-space: nowrap; }
    .brand img { border-radius: .45rem; }
    .nav { gap: clamp(.85rem, 3vw, 2.25rem); }
    .nav a, .footer a { color: var(--muted); font-size: .875rem; font-weight: 500; text-decoration: none; }
    .nav a:hover, .footer a:hover { color: var(--ink); text-decoration: underline; }
    .hero { display: grid; grid-template-columns: minmax(0, .81fr) minmax(0, 1.45fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding-block: clamp(3.25rem, 7vw, 7rem); }
    .display { font-family: 'Newsreader', Georgia, serif; font-weight: 500; letter-spacing: -.055em; }
    h1.display { font-size: clamp(3.35rem, 6vw, 6rem); line-height: .94; }
    h1 span { display: block; color: var(--accent); }
    h2.display { font-size: clamp(2.65rem, 5vw, 4.5rem); line-height: 1; }
    .intro { margin-top: 1.45rem; max-width: 29ch; color: var(--muted); font-size: clamp(1rem, 1.35vw, 1.16rem); }
    .actions { margin-top: 1.85rem; }
    .download { min-height: 3rem; padding: .65rem 1.05rem; border-radius: .55rem; color: var(--action-ink); background: var(--action); font-size: .925rem; font-weight: 650; text-decoration: none; }
    .download:hover { background: var(--action-hover); }
    .download-mark { width: .82rem; height: .82rem; position: relative; border-bottom: 1px solid currentColor; }
    .download-mark::before { content: ''; position: absolute; width: .42rem; height: .42rem; inset: .05rem auto auto .2rem; border: solid currentColor; border-width: 0 1px 1px 0; transform: rotate(45deg); }
    .system { color: var(--muted); margin-top: .62rem; font-size: .8rem; }
    .frame { background: radial-gradient(ellipse at 88% 0%, var(--halo), transparent 72%), var(--panel); border: 1px solid var(--line); border-radius: clamp(.75rem, 2vw, 1.2rem); padding: clamp(.6rem, 2vw, 1.65rem); }
    .frame img { width: 100%; border-radius: .55rem; box-shadow: 0 .65rem 1.75rem var(--shadow); }
    .section { border-top: 1px solid var(--line); padding-block: clamp(3rem, 6.4vw, 6rem); }
    .section-summary { color: var(--muted); max-width: 44ch; margin-top: .75rem; }
    .channels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.75rem; margin: 2.1rem 0 0; padding: 0; list-style: none; }
    .channels li { border-top: 1px solid var(--line); padding-top: 1.1rem; }
    .channels h3 { font-size: 1.02rem; font-weight: 650; letter-spacing: -.025em; }
    .channels p, .workflow p, details p { color: var(--muted); margin-top: .32rem; }
    .source-icon { display: inline-block; width: 1rem; height: 1rem; color: var(--ink); }
    .workflow { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(1.75rem, 6vw, 6rem); align-items: center; }
    .workflow ul { margin: 1.5rem 0 0; padding: 0; list-style: none; }
    .workflow li + li { margin-top: 1.05rem; }
    .workflow h3 { font-size: 1rem; font-weight: 650; }
    .faq { display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1.4fr); gap: clamp(1.25rem, 6vw, 6rem); }
    details { border-top: 1px solid var(--line); padding-block: .85rem; }
    details:last-child { border-bottom: 1px solid var(--line); }
    summary { cursor: pointer; list-style: none; font-weight: 600; padding-block: .2rem; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: ''; width: .45rem; height: .45rem; margin: .1rem .3rem .3rem .5rem; flex-shrink: 0; border: solid var(--accent); border-width: 0 1px 1px 0; transform: rotate(45deg); }
    details[open] summary::after { transform: rotate(225deg); }
    details p { padding-right: 1.55rem; padding-bottom: .25rem; max-width: 63ch; }
    .footer { border-top: 1px solid var(--line); padding-block: 1.4rem 1.65rem; row-gap: .75rem; }
    .footer .brand { color: var(--ink); font-size: 1rem; }
    @media (max-width: 56rem) {
      .hero { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
      .workflow { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 44rem) {
      .hero, .workflow, .faq { grid-template-columns: minmax(0, 1fr); }
      .workflow .frame { order: 1; }
      .channels { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
      .header { min-height: 4.4rem; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .download { transition: background-color 160ms ease-out; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="flex gap-4 items-center justify-between header wrap">
    <a class="inline-flex gap-2 items-center brand" href="/">
      <img src="/images/app-icon.png" alt="" width="30" height="30">
      Attic
    </a>
    <nav class="flex items-center nav" aria-label="Main navigation">
      <a href="#features">Features</a>
      <a href="#faq">FAQ</a>
      <a href="{{ source }}">GitHub</a>
    </nav>
  </header>

  <main id="main" class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title" class="display">Keep the chat. <span>Clear the inbox.</span></h1>
        <p class="intro">One Mac inbox for Messages, WhatsApp, Slack, and Discord, with a searchable archive you keep.</p>
        <div class="actions">
          <a class="inline-flex gap-2 items-center download" href="{{ download }}">
            <span class="download-mark" aria-hidden="true"></span> Download for Mac
          </a>
          <p class="system">For Macs with Apple silicon</p>
        </div>
      </div>

      <figure class="frame">
        <picture>
          <source srcset="/images/screens/attic-inbox-dark.webp" media="(prefers-color-scheme: dark)">
          <img src="/images/screens/attic-inbox-light.webp" alt="Attic's Mac inbox showing sample conversations and an open message thread" width="1760" height="1163" fetchpriority="high">
        </picture>
      </figure>
    </section>

    <section id="features" class="section" aria-labelledby="sources-title">
      <h2 id="sources-title" class="display">Your chats in one place.</h2>
      <p class="section-summary">Connect the services you use. Switch between them or work through everything in one inbox.</p>
      <ul class="channels">
        @foreach (channels as channel)
          <li>
            <h3 class="flex gap-2 items-center"><span class="source-icon {{ channel.icon }}" aria-hidden="true"></span>{{ channel.name }}</h3>
            <p>{{ channel.body }}</p>
          </li>
        @endforeach
      </ul>
    </section>

    <section class="section workflow" aria-labelledby="archive-title">
      <figure class="frame">
        <picture>
          <source srcset="/images/screens/attic-find-dark.webp" media="(prefers-color-scheme: dark)">
          <img src="/images/screens/attic-find-light.webp" alt="Attic showing search results across sample conversations" width="1760" height="1100" loading="lazy">
        </picture>
      </figure>
      <div>
        <h2 id="archive-title" class="display">Archive now.<br>Find it later.</h2>
        <ul>
          <li>
            <h3>Keep a local copy</h3>
            <p>Move quiet conversations out of your inbox while keeping their history on your Mac.</p>
          </li>
          <li>
            <h3>Search across services</h3>
            <p>Find a message in your inbox or archive without remembering which app it came from.</p>
          </li>
          <li>
            <h3>Pick up where you left off</h3>
            <p>When new messages arrive, Attic can bring the chat back or keep filing it in the archive.</p>
          </li>
        </ul>
      </div>
    </section>

    <section id="faq" class="faq section" aria-labelledby="faq-title">
      <h2 id="faq-title" class="display">Questions</h2>
      <div>
        @foreach (faqs as faq)
          <details>
            <summary class="flex items-center justify-between">{{ faq.question }}</summary>
            <p>{{ faq.answer }}</p>
          </details>
        @endforeach
      </div>
    </section>
  </main>

  <footer class="flex flex-wrap gap-4 items-center justify-between footer wrap">
    <a class="inline-flex gap-2 items-center brand" href="/">
      <img src="/images/app-icon.png" alt="" width="24" height="24" loading="lazy">
      Attic
    </a>
    <div class="flex flex-wrap items-center nav">
      <a href="{{ releases }}">Releases</a>
      <a href="{{ source }}">Source on GitHub</a>
    </div>
  </footer>
</body>
</html>
