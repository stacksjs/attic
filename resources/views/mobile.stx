<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title>Texts</title>
  <!--
    Texts on the phone. It keeps its own copy of the archive (Craft's native
    SQLite, see resources/functions/phone-archive.ts) so it reads anywhere,
    and syncs with the paired Mac on the same Wi-Fi: every request sealed with
    the key from the pairing QR code. Built into the iOS and Android apps by
    `bun run build:mobile`; on the Mac it is also served at /mobile.
  -->
  <style>
    :root {
      --bg: #f2f2f7; --surface: #ffffff; --label: #000000; --secondary: #6e6e73; --separator: rgba(60, 60, 67, .18);
      --accent: #0a84ff; --bubble-in: #e9e9eb; --bubble-out: #0a84ff; --chip: rgba(118, 118, 128, .12);
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #000000; --surface: #1c1c1e; --label: #ffffff; --secondary: #8e8e93; --separator: rgba(84, 84, 88, .55); --bubble-in: #262628; --chip: rgba(118, 118, 128, .24); }
    }
    body { margin: 0; background: var(--bg); color: var(--label); font: 17px/1.35 -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    .muted { color: var(--secondary); }
    .cell { display: flex; gap: 12px; align-items: center; padding: 10px 16px; background: var(--surface); border: 0; width: 100%; text-align: left; color: inherit; font: inherit; }
    .cell + .cell { box-shadow: inset 72px 0 0 var(--surface), inset 0 .5px 0 var(--separator); }
    .avatar { width: 46px; height: 46px; border-radius: 50%; flex: none; display: grid; place-items: center; overflow: hidden; color: #fff; font-weight: 600; font-size: 17px; background: linear-gradient(180deg, #a5abb8, #858994); }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    /* A long press is for tapbacks: no callout, magnifier or text selection under the finger. */
    .bubble { max-width: 78%; padding: 8px 13px; border-radius: 19px; white-space: pre-wrap; overflow-wrap: anywhere; position: relative; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
    .bubble.in { background: var(--bubble-in); }
    .bubble.out { background: var(--bubble-out); color: #fff; }
    .reactions { position: absolute; top: -14px; right: -6px; display: flex; gap: 1px; background: var(--surface); border-radius: 12px; padding: 1px 5px; font-size: 13px; box-shadow: 0 1px 3px rgba(0, 0, 0, .2); }
    /* The held bubble, lifted over the dimmed transcript with its tapbacks above it. */
    .scrim { position: fixed; inset: 0; z-index: 40; touch-action: none; background: rgba(0, 0, 0, .28); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: fade-in .15s ease-out; }
    .lifted { position: fixed; z-index: 41; touch-action: none; box-sizing: border-box; max-width: none; margin: 0; }
    .tapback-bar { position: fixed; z-index: 42; display: flex; gap: 2px; padding: 5px; border-radius: 26px; background: var(--surface); box-shadow: 0 6px 24px rgba(0, 0, 0, .22); animation: tapback-in .18s ease-out; }
    .tapback-bar button { width: 40px; height: 40px; border: 0; border-radius: 50%; padding: 0; display: grid; place-items: center; background: transparent; font-size: 22px; line-height: 1; }
    .tapback-bar button[aria-pressed='true'] { background: var(--accent); }
    @keyframes fade-in { from { opacity: 0; } }
    @keyframes tapback-in { from { opacity: 0; transform: translateY(6px) scale(.9); } }
    @media (prefers-reduced-motion: reduce) { .scrim, .tapback-bar { animation: none; } }
    .search { width: 100%; box-sizing: border-box; border: 0; border-radius: 10px; padding: 8px 12px; background: var(--chip); color: inherit; font: inherit; font-size: 16px; }
    .button { border: 0; border-radius: 12px; padding: 13px 18px; font: inherit; font-weight: 600; background: var(--accent); color: #fff; width: 100%; }
    .button.plain { background: var(--chip); color: var(--accent); }
    /* 16px: smaller inputs make iOS zoom the page when they take focus. */
    textarea { width: 100%; box-sizing: border-box; border: 0; border-radius: 12px; padding: 12px; background: var(--surface); color: inherit; font: 16px ui-monospace, monospace; }
  </style>
</head>
<body>
<script client>
import { haptics } from '@stacksjs/mobile'
import { askMac, avatarFor, forgetPairing, lastSynced, loadPairing, localConversations, localMessages, onPairingLink, savePairing, scanPairingCode, syncArchive } from '../functions/phone-archive'
import { foldFallbackReactions } from '../functions/fallback-reactions'
import { isMine, pressAndHold, reactionsByMessage, TAPBACKS } from '../functions/tapbacks'

const screen = state('loading')
const pairing = state(null)
const view = state('archived')
const query = state('')
const archive = state([])
const inbox = state([])
const reachable = state(false)
const syncing = state(false)
const syncedAt = state(null)
const note = state('')
const pasted = state('')
const settingsOpen = state(false)
const openKey = state('')
const transcript = state([])
const avatars = state({})
const busy = state(false)
/** Tapbacks sent from this phone, shown at once and kept until a sync brings the real ones. */
const sentReactions = state([])
/** The held bubble whose tapbacks are showing: the message, and where to draw it. */
const reacting = state(null)

const conversations = derived(() => {
  const list = view() === 'inbox' ? inbox() : archive()
  const q = query().trim().toLowerCase()
  return q ? list.filter(c => (c.title ?? '').toLowerCase().includes(q) || (c.preview ?? '').toLowerCase().includes(q)) : list
})
const open = derived(() => [...archive(), ...inbox()].find(c => c.key === openKey()) ?? null)
const bubbles = derived(() => {
  const all = transcript()
  const sent = sentReactions().filter(r => r.conversationKey === openKey())
  // Tapbacks an SMS or RCS phone wrote out as sentences, read as the Mac reads them.
  const folded = foldFallbackReactions(all.filter(m => m.kind !== 'reaction'))
  const written = folded.reactions.map(r => ({ kind: 'reaction', targetGuid: r.targetGuid, reaction: r.reaction, reactionRemoved: r.removed, isFromMe: r.isFromMe, senderName: r.senderName, sentAt: r.sentAt }))
  const reactions = reactionsByMessage([...all, ...sent, ...written].sort((a, b) => a.sentAt - b.sentAt))
  const byGuid = new Map(all.map(m => [m.guid, m]))
  return all.filter(m => m.kind !== 'reaction' && !folded.hidden.has(m.guid) && (m.kind !== 'event' || m.text)).map(m => folded.notes.has(m.guid)
    ? { ...m, kind: 'event', text: folded.notes.get(m.guid), reactions: [], quoted: null }
    : {
        ...m,
        reactions: reactions.get(m.guid) ?? [],
        quoted: m.replyToGuid && byGuid.get(m.replyToGuid) ? (byGuid.get(m.replyToGuid).text ?? 'Attachment') : null,
      })
})

/** Haptics where the phone has them; a browser tab has none, and nothing should fail for it. */
function feel(kind) {
  const done = kind === 'hold' ? haptics.impact('medium') : kind === 'pick' ? haptics.selection() : haptics.notification('error')
  Promise.resolve(done).catch(() => {})
}

/*
 * Long-press a bubble for its tapbacks, as in Messages: a firm tap, the rest
 * of the conversation dimmed, the bubble lifted with the six tapbacks just
 * above it. The Mac does the reacting, so only a paired phone offers it.
 */
const bubbleHold = pressAndHold((m, target) => {
  const rect = target.getBoundingClientRect()
  feel('hold')
  reacting.set({
    m,
    rect: { top: rect.top, left: rect.left, width: rect.width, height: rect.height, right: rect.right, bottom: rect.bottom },
    // Too near the top to fit above (the navigation bar is there): below it instead.
    below: rect.top < 140,
  })
})

function holdStart(event, m) {
  if (pairing() && m.kind === 'message' && !m.unsent)
    bubbleHold.down(event, m)
}

function holdMove(event) {
  bubbleHold.move(event)
}

function holdEnd() {
  bubbleHold.up()
}

function lifted(r) {
  return `top: ${r.rect.top}px; left: ${r.rect.left}px; width: ${r.rect.width}px; min-height: ${r.rect.height}px`
}

function barStyle(r) {
  const top = r.below ? `top: ${Math.round(r.rect.bottom + 10)}px` : `top: ${Math.round(r.rect.top - 60)}px`
  const side = r.m.isFromMe ? `right: max(8px, calc(100vw - ${Math.round(r.rect.right)}px))` : `left: max(8px, ${Math.round(r.rect.left)}px)`
  return `${top}; ${side}`
}

function dismissReacting() {
  // The tap that lifts the finger after the hold lands on the scrim: it is not a dismissal.
  if (!bubbleHold.justHeld())
    reacting.set(null)
}

async function chooseTapback(reaction) {
  const r = reacting()
  if (!r)
    return
  reacting.set(null)
  feel('pick')
  const key = r.m.conversationKey ?? openKey()
  const remove = isMine(r.m.reactions, reaction)
  const sent = {
    guid: `sent-${Date.now()}-${Math.random().toString(36).slice(2)}`,
    conversationKey: key,
    kind: 'reaction',
    text: null,
    isFromMe: true,
    sentAt: Date.now(),
    senderName: null,
    targetGuid: r.m.guid,
    reaction,
    reactionRemoved: remove,
  }
  sentReactions.set([...sentReactions(), sent])
  try {
    await askMac(pairing(), 'react', { key, messageId: r.m.guid, reaction, remove })
  }
  catch (error) {
    sentReactions.set(sentReactions().filter(s => s.guid !== sent.guid))
    feel('error')
    say(unreachable(error) ? `Not on the same network as ${pairing().name}, so the tapback was not sent.` : error.message)
  }
}

function when(ms) {
  if (!ms)
    return ''
  const date = new Date(ms)
  const days = (Date.now() - ms) / 86_400_000
  if (days < 1 && date.getDate() === new Date().getDate())
    return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
  if (days < 7)
    return date.toLocaleDateString([], { weekday: 'long' })
  return date.toLocaleDateString([], { month: 'numeric', day: 'numeric', year: '2-digit' })
}

/** Whether a request failed because the Mac could not be reached, rather than because it said no. */
function unreachable(error) {
  return !!(error.message?.includes('abort') || error.message?.includes('Load failed') || error.message?.includes('fetch'))
}

function say(text) {
  note.set(text)
  setTimeout(() => note() === text && note.set(''), 4000)
}

async function loadLocal() {
  archive.set(await localConversations())
  syncedAt.set(await lastSynced())
  loadAvatars(archive())
}

async function loadAvatars(list) {
  for (const c of list.slice(0, 60)) {
    if (!c.avatar || avatars()[c.avatar] !== undefined)
      continue
    const data = await avatarFor(reachable() ? pairing() : null, c.avatar)
    avatars.set({ ...avatars(), [c.avatar]: data })
  }
}

async function sync() {
  if (!pairing() || syncing())
    return
  syncing.set(true)
  try {
    const result = await syncArchive(pairing())
    reachable.set(true)
    await loadLocal()
    inbox.set(await askMac(pairing(), 'inbox'))
    loadAvatars(inbox())
    if (result.messages)
      say(`${result.messages.toLocaleString()} new messages kept`)
  }
  catch (error) {
    reachable.set(false)
    say(unreachable(error) ? `Not on the same network as ${pairing().name}. The archive here still reads.` : error.message)
  }
  finally {
    syncing.set(false)
  }
}

async function finishPairing(code) {
  const saved = await savePairing(code ?? '')
  if (!saved) {
    say('That is not an Texts pairing code.')
    return
  }
  pairing.set(saved)
  screen.set('list')
  await sync()
}

async function scan() {
  try {
    const code = await scanPairingCode()
    if (code)
      await finishPairing(code)
    else
      say('No camera here: paste the code from the Mac instead.')
  }
  catch (error) {
    say(error.message)
  }
}

async function openConversation(c) {
  openKey.set(c.key)
  transcript.set(await localMessages(c.key))
  screen.set('chat')
}

function back() {
  reacting.set(null)
  screen.set('list')
  openKey.set('')
}

async function toggleArchive() {
  const c = open()
  if (!c || busy())
    return
  busy.set(true)
  try {
    await askMac(pairing(), c.state === 'archived' ? 'unarchive' : 'archive', { key: c.key })
    say(c.state === 'archived' ? `${c.title} is back in the Inbox` : `${c.title} archived`)
    await sync()
    back()
  }
  catch (error) {
    say(`The Mac has to be reachable for that: ${error.message}`)
  }
  finally {
    busy.set(false)
  }
}

async function unpair() {
  await forgetPairing()
  settingsOpen.set(false)
  pairing.set(null)
  archive.set([])
  inbox.set([])
  screen.set('pair')
}

async function refreshed(event) {
  await sync()
  event.detail?.done?.()
}

onMount(async () => {
  // Scanning the Mac's QR code with the Camera app opens this link.
  onPairingLink(code => finishPairing(code))
  const saved = await loadPairing()
  pairing.set(saved)
  screen.set(saved ? 'list' : 'pair')
  if (saved) {
    await loadLocal()
    sync()
  }
})
</script>

<NativeAppShell>
  <!-- Pairing: scan the code the Mac shows under Phone > Pair a phone. -->
  <main :if="screen() === 'pair'" class="flex flex-col gap-5 justify-center px-6 min-h-screen" style="padding-top: env(safe-area-inset-top)">
    <div class="text-center">
      <div class="mb-3 mx-auto text-[56px] i-hugeicons-archive-02" style="color: var(--accent)"></div>
      <h1 class="m-0 font-bold text-[30px]">Texts</h1>
      <p class="mb-0 mt-2 leading-snug muted">Your archive from iMessage, WhatsApp, Slack and Discord, kept on this phone too. On your Mac, open Texts and choose Pair a phone, then point this phone's camera at the code.</p>
    </div>
    <button class="button" @click="scan()">Scan the code on your Mac</button>
    <textarea :if="true" rows="3" placeholder="Or paste the pairing code" x-model="pasted"></textarea>
    <button class="button plain" :disabled="!pasted().trim()" @click="finishPairing(pasted())">Pair with this code</button>
  </main>

  <!-- The archive (kept here) and the Mac's inbox (when reachable). -->
  <main :if="screen() === 'list'">
    <NativeNavBar title="Texts">
      <template #actions>
        <button class="p-2 bg-transparent border-0" style="color: var(--accent)" aria-label="Settings" @click="settingsOpen.set(true)"><span class="text-[22px] i-hugeicons-settings-02"></span></button>
      </template>
    </NativeNavBar>
    <NativePullToRefresh @refresh="refreshed($event)">
      <div class="flex flex-col gap-2 pb-2 px-4">
        <input class="search" type="search" placeholder="Search" x-model="query">
        <NativeSegmentedControl :options="[{ label: 'Archived', value: 'archived' }, { label: 'Inbox', value: 'inbox' }]" v-model:value="view" label="Show" />
        <div class="px-1 text-[12px] muted">{{ syncing() ? 'Syncing…' : reachable() ? `Synced with ${pairing()?.name ?? 'your Mac'}` : syncedAt() ? `Last synced ${when(syncedAt())}` : 'Not synced yet' }}</div>
      </div>
      <div :if="view() === 'inbox' && !reachable()" class="px-8 py-12 text-[15px] text-center muted">The Inbox lives on your Mac. Join the same Wi-Fi to see it; the archive below works anywhere.</div>
      <div :if="conversations().length === 0 && (view() === 'archived' || reachable())" class="px-8 py-12 text-[15px] text-center muted">{{ query() ? 'Nothing matches.' : view() === 'archived' ? 'Nothing archived yet.' : 'All caught up.' }}</div>
      <div class="overflow-hidden mb-8 mx-4 rounded-[12px]">
        <button :for="c in conversations().slice(0, 300)" :key="c.key" class="cell" @click="openConversation(c)">
          <span class="avatar">
            <img :if="avatars()[c.avatar]" :src="avatars()[c.avatar]" alt="">
            <span :if="!avatars()[c.avatar]">{{ c.initials || '#' }}</span>
          </span>
          <span class="flex-1 min-w-0">
            <span class="flex gap-2 justify-between">
              <span class="font-semibold truncate">{{ c.title }}</span>
              <span class="shrink-0 text-[14px] muted">{{ when(c.lastMessageAt) }}</span>
            </span>
            <span class="block text-[15px] truncate muted">{{ c.preview || c.subtitle || `${c.savedMessages} messages kept` }}</span>
          </span>
        </button>
      </div>
    </NativePullToRefresh>
  </main>

  <!-- One conversation, read from the phone's own copy. -->
  <main :if="screen() === 'chat' && open()">
    <NativeNavBar :title="open()?.title ?? ''" :large="false">
      <template #leading>
        <button class="flex gap-1 items-center p-2 bg-transparent border-0" style="color: var(--accent); font: inherit" @click="back()"><span class="text-[22px] i-hugeicons-arrow-left-01"></span>Texts</button>
      </template>
      <template #actions>
        <button class="p-2 bg-transparent border-0" style="color: var(--accent)" :disabled="busy()" :aria-label="open()?.state === 'archived' ? 'Move to Inbox' : 'Archive'" @click="toggleArchive()">
          <span class="text-[22px]" :class="open()?.state === 'archived' ? 'i-hugeicons-inbox-upload' : 'i-hugeicons-archive-02'"></span>
        </button>
      </template>
    </NativeNavBar>
    <div class="flex flex-col gap-[3px] pb-10 pt-2 px-3">
      <div :if="bubbles().length === 0" class="py-12 text-[15px] text-center muted">Only the Mac has this conversation's messages. Sync on the same Wi-Fi to keep a copy here.</div>
      <div :for="m in bubbles()" :key="m.guid" class="flex flex-col" :class="m.isFromMe ? 'items-end' : 'items-start'" :style="m.reactions.length ? 'margin-top: 14px' : ''">
        <div :if="m.kind === 'event'" class="self-center py-1 text-[12px] muted">{{ m.text }}</div>
        <div :if="m.quoted" class="mb-[2px] px-3 py-1 max-w-[70%] text-[13px] truncate rounded-[12px] muted" style="background: var(--chip); border-left: 3px solid var(--separator)">{{ m.quoted }}</div>
        <div :for="a in m.attachments" class="mb-[2px] bubble" :class="m.isFromMe ? 'out' : 'in'"><span class="i-hugeicons-attachment-01"></span> {{ a.name }}</div>
        <div :if="m.kind === 'message' && m.text" class="bubble" :class="m.isFromMe ? 'out' : 'in'" @pointerdown="holdStart($event, m)" @pointermove="holdMove($event)" @pointerup="holdEnd()" @pointercancel="holdEnd()" @contextmenu="$event.preventDefault()">
          <span :if="m.reactions.length" class="reactions"><span :for="r in m.reactions">{{ r.reaction }}</span></span>{{ m.text }}
        </div>
        <div :if="m.unsent" class="px-3 italic text-[12px] muted">{{ m.isFromMe ? 'You unsent a message' : 'Unsent' }}</div>
      </div>
    </div>
  </main>

  <!-- A held bubble: the conversation dimmed, the bubble lifted, its tapbacks above. Tapping outside puts it back. -->
  <div :if="reacting()" class="scrim" @click="dismissReacting()"></div>
  <div :if="reacting()" class="bubble lifted" :class="reacting()?.m.isFromMe ? 'out' : 'in'" :style="lifted(reacting())" @click="dismissReacting()">
    <span :if="reacting()?.m.reactions.length" class="reactions"><span :for="r in reacting()?.m.reactions ?? []">{{ r.reaction }}</span></span>{{ reacting()?.m.text }}
  </div>
  <div :if="reacting()" class="tapback-bar" role="toolbar" aria-label="Tapbacks" :style="barStyle(reacting())">
    <button :for="t in TAPBACKS" :key="t.emoji" :aria-label="t.label" :aria-pressed="isMine(reacting()?.m.reactions ?? [], t.emoji) ? 'true' : 'false'" @click="chooseTapback(t.emoji)">{{ t.emoji }}</button>
  </div>

  <NativeSheet v-model:open="settingsOpen" title="Texts">
    <div class="flex flex-col gap-3 pb-6 px-4">
      <div class="text-[15px]">Paired with <b>{{ pairing()?.name }}</b></div>
      <div class="text-[14px] muted">{{ syncedAt() ? `Last synced ${when(syncedAt())}` : 'Not synced yet' }} · {{ archive().length.toLocaleString() }} conversations kept here</div>
      <button class="button plain" @click="sync()">Sync now</button>
      <button class="button plain" style="color: #ff453a" @click="unpair()">Unpair and remove the archive from this phone</button>
    </div>
  </NativeSheet>

  <div :if="note()" class="fixed left-4 right-4 px-4 py-3 text-[14px] text-center text-white rounded-[12px]" style="bottom: calc(env(safe-area-inset-bottom) + 16px); background: rgba(40, 40, 40, .92)">{{ note() }}</div>
</NativeAppShell>
</body>
</html>
