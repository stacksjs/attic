<script server>
/**
 * attic.app's front page. The product is the Mac app (the window is
 * resources/views/app.stx, served at /app by the app itself); this page
 * explains it and links the download.
 *
 * Every claim here is what the app does today, including where an app's own
 * API stops it: Discord DMs, private Slack channels.
 */
const download = 'https://github.com/stacksjs/attic/releases/latest/download/Attic.dmg'

const steps = [
  {
    icon: 'i-hugeicons-copy-01',
    title: 'Attic keeps a complete copy',
    body: 'Every message, reaction, edit and photo is copied to your Mac and checked before anything else happens.',
  },
  {
    icon: 'i-hugeicons-archive-02',
    title: 'Then it leaves the real app',
    body: 'Slack closes the DM, Discord archives the thread, Messages deletes the conversation. Your list gets shorter.',
  },
  {
    icon: 'i-hugeicons-arrow-turn-backward',
    title: 'It comes back when they write',
    body: 'A new message brings the conversation back to your inbox with its whole history attached, like email.',
  },
]

const sources = [
  {
    name: 'iMessage',
    icon: 'i-hugeicons-message-01',
    tint: 'source-imessage',
    body: 'Read straight from Messages on your Mac. Archiving removes the thread through Messages itself, so iCloud and your iPhone stay in step, and unarchiving recovers it.',
  },
  {
    name: 'WhatsApp',
    icon: 'i-hugeicons-whatsapp',
    tint: 'source-whatsapp',
    body: 'Read from WhatsApp on your Mac. Archiving presses WhatsApp\'s own Archive, so your phone sees it too, and Attic checks WhatsApp recorded it before calling it done.',
  },
  {
    name: 'Slack',
    icon: 'i-hugeicons-slack',
    tint: 'source-slack',
    body: 'DMs close and public channels are left, both undone with Unarchive. Private channels stay put, since leaving one needs an invite back.',
  },
  {
    name: 'Discord',
    icon: 'i-hugeicons-discord',
    tint: 'source-discord',
    body: 'Server channels and threads through a bot you add. Threads archive in Discord. Personal DMs stay in Discord: its rules keep apps out of them.',
  },
]

const faqs = [
  {
    q: 'Can archiving lose a conversation?',
    a: 'Attic only takes a conversation out of the app after its copy is complete. If any message is missing from the copy, nothing leaves. Messages also keeps deleted conversations in Recently Deleted for 30 days.',
  },
  {
    q: 'What happens when someone writes again?',
    a: 'The conversation returns to your inbox in Attic, with the archived history above the new messages. If you prefer, Attic can keep it archived and quietly add the new messages to the copy.',
  },
  {
    q: 'Can I unarchive?',
    a: 'Yes. WhatsApp unarchives the chat, Slack reopens the DM or rejoins the channel, Discord unarchives the thread, and Messages recovers the conversation from Recently Deleted while it is still there.',
  },
  {
    q: 'What does Attic need from my Mac?',
    a: 'Full Disk Access to read Messages and WhatsApp, and Accessibility to press Delete and Recover in Messages and Archive in WhatsApp for you. Slack and Discord use tokens kept in your keychain.',
  },
  {
    q: 'Where do my messages go?',
    a: 'Nowhere. Attic runs on your Mac with no account and no server. The copies live in your Library folder, searchable and yours to delete.',
  },
]

const year = new Date().getFullYear()
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Attic: one calm inbox for iMessage, WhatsApp, Slack and Discord</title>
  <meta name="description" content="Attic gathers iMessage, WhatsApp, Slack and Discord in one Mac app. Archive a conversation and it leaves the real app too, with a complete copy kept.">
  <meta property="og:title" content="Attic: one calm inbox for every chat">
  <meta property="og:description" content="Archive a conversation and it leaves the real app too. Every message kept, on your Mac.">
  <meta property="og:image" content="/images/screens/attic-light.png">
  <link rel="icon" href="/images/app-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&display=swap">
  <style>
    :root {
      --ink: #14171c;
      --ink-soft: #4a5260;
      --ink-faint: #737b88;
      --page: #f4f5f7;
      --surface: #ffffff;
      --line: rgba(20, 23, 28, .09);
      --accent: #d9542f;
      --accent-ink: #ffffff;
      --accent-wash: rgba(217, 84, 47, .1);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --ink: #eef0f3;
        --ink-soft: #a7afbb;
        --ink-faint: #7d8592;
        --page: #0e1014;
        --surface: #171a20;
        --line: rgba(238, 240, 243, .09);
        --accent: #f0714c;
        --accent-ink: #1a0d08;
        --accent-wash: rgba(240, 113, 76, .14);
      }
    }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--page);
      color: var(--ink);
      font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    .soft { color: var(--ink-soft); }
    .faint { color: var(--ink-faint); }
    .btn {
      display: inline-flex; align-items: center; gap: .5rem; height: 2.75rem; padding: 0 1.25rem;
      border-radius: 999px; font-weight: 600; text-decoration: none; white-space: nowrap;
      transition: transform .15s ease, background-color .15s ease;
    }
    .btn:active { transform: translateY(1px); }
    .btn-primary { background: var(--accent); color: var(--accent-ink); }
    .btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, black); }
    .btn-ghost { color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
    .btn-ghost:hover { background: var(--accent-wash); }
    .shot {
      border-radius: 14px;
      box-shadow: 0 30px 60px -20px rgba(80, 30, 15, .28), 0 0 0 1px var(--line);
    }
    .tile { border-radius: 20px; background: var(--surface); box-shadow: 0 0 0 1px var(--line); }
    .source-imessage { background: linear-gradient(160deg, color-mix(in srgb, #0a84ff 14%, var(--surface)), var(--surface) 70%); }
    .source-whatsapp { background: linear-gradient(160deg, color-mix(in srgb, #25d366 16%, var(--surface)), var(--surface) 70%); }
    .source-slack { background: linear-gradient(160deg, color-mix(in srgb, #e01e5a 14%, var(--surface)), var(--surface) 70%); }
    .source-discord { background: linear-gradient(160deg, color-mix(in srgb, #5865f2 16%, var(--surface)), var(--surface) 70%); }
    .source-imessage .glyph { color: #0a84ff; }
    .source-whatsapp .glyph { color: #1da851; }
    .source-slack .glyph { color: #e01e5a; }
    .source-discord .glyph { color: #5865f2; }
    details summary { list-style: none; cursor: pointer; }
    details summary::-webkit-details-marker { display: none; }
    details[open] .chevron { transform: rotate(45deg); }
    .chevron { transition: transform .2s ease; }
    /* Steps rise in as they scroll into view, where the browser supports it. */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .rise { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
        @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
      }
    }
  </style>
</head>
<body>
  <header class="max-w-6xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 no-underline font-semibold text-[17px]">
      <img src="/images/app-icon.png" alt="" width="30" height="30">
      Attic
    </a>
    <nav class="flex items-center gap-6 text-[14px]">
      <a href="#how" class="hidden sm:inline no-underline soft hover:opacity-80">How it works</a>
      <a href="#privacy" class="hidden sm:inline no-underline soft hover:opacity-80">Privacy</a>
      <a href="#faq" class="hidden sm:inline no-underline soft hover:opacity-80">FAQ</a>
      <a href="{{ download }}" class="btn btn-primary h-9 px-4 text-[14px]">Get Attic</a>
    </nav>
  </header>

  <main>
    <!-- Hero: the promise on the left, the real app on the right. -->
    <section class="max-w-6xl mx-auto px-5 md:px-8 pt-10 md:pt-16 pb-16 grid md:grid-cols-[1fr_1.35fr] gap-10 md:gap-12 items-center">
      <div>
        <h1 class="text-4xl md:text-5xl lg:text-[56px] font-bold tracking-tight leading-[1.05] m-0">One calm inbox for every chat.</h1>
        <p class="soft text-[17px] md:text-lg leading-relaxed mt-5 mb-8 max-w-[34ch]">Attic gathers iMessage, WhatsApp, Slack and Discord on your Mac. Archive a conversation and it leaves the real app too.</p>
        <div class="flex flex-wrap gap-3">
          <a href="{{ download }}" class="btn btn-primary"><span class="i-hugeicons-apple text-[18px]"></span>Get Attic</a>
          <a href="#how" class="btn btn-ghost">How it works</a>
        </div>
      </div>
      <picture>
        <source srcset="/images/screens/attic-dark.png" media="(prefers-color-scheme: dark)">
        <img src="/images/screens/attic-light.png" alt="Attic on a Mac: one inbox of WhatsApp, iMessage, Slack and Discord conversations, with contact photos" width="1440" height="900" class="shot w-full h-auto block">
      </picture>
    </section>

    <!-- How archiving works: one column of three moments. -->
    <section id="how" class="max-w-6xl mx-auto px-5 md:px-8 py-16 md:py-24 grid md:grid-cols-[1fr_1.4fr] gap-10 md:gap-16">
      <div class="md:sticky md:top-24 self-start">
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] m-0 mb-3" style="color: var(--accent)">Archive, for real</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight m-0 max-w-[16ch]">The chat apps only let you delete. Attic archives.</h2>
      </div>
      <ol class="list-none m-0 p-0 flex flex-col gap-4">
        @foreach (steps as step)
          <li class="rise tile p-6 md:p-7 flex gap-5">
            <span class="shrink-0 w-11 h-11 rounded-full grid place-items-center" style="background: var(--accent-wash); color: var(--accent)"><span class="{{ step.icon }} text-[20px]"></span></span>
            <div>
              <h3 class="text-[18px] font-semibold m-0 mb-1.5">{{ step.title }}</h3>
              <p class="soft m-0 leading-relaxed max-w-[52ch]">{{ step.body }}</p>
            </div>
          </li>
        @endforeach
      </ol>
    </section>

    <!-- Sources: a bento of the four apps and the search across them. -->
    <section class="max-w-6xl mx-auto px-5 md:px-8 py-16 md:py-20">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight m-0 mb-10 max-w-[22ch]">Four apps, one list, honest about each.</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (sources as source)
          <article class="tile {{ source.tint }} p-6 md:p-7 flex flex-col gap-3">
            <span class="glyph {{ source.icon }} text-[30px]"></span>
            <h3 class="text-[19px] font-semibold m-0">{{ source.name }}</h3>
            <p class="soft m-0 leading-relaxed text-[15px]">{{ source.body }}</p>
          </article>
        @endforeach
        <article class="tile md:col-span-2 lg:col-span-4 p-6 md:p-8 grid md:grid-cols-[1fr_1.2fr] gap-8 items-center overflow-hidden">
          <div>
            <span class="i-hugeicons-search-01 text-[28px]" style="color: var(--accent)"></span>
            <h3 class="text-[22px] font-semibold mt-3 mb-2">Search everything you kept</h3>
            <p class="soft m-0 leading-relaxed max-w-[44ch]">Every archived message across all four apps is indexed on your Mac. Find the address from last spring without scrolling a single thread.</p>
          </div>
          <picture>
            <source srcset="/images/screens/attic-search-dark.png" media="(prefers-color-scheme: dark)">
            <img src="/images/screens/attic-search-light.png" alt="Searching archived messages in Attic" width="1440" height="900" class="shot w-full h-auto block" loading="lazy">
          </picture>
        </article>
      </div>
    </section>

    <!-- Privacy: a single statement. -->
    <section id="privacy" class="max-w-6xl mx-auto px-5 md:px-8 py-20 md:py-28 text-center">
      <span class="i-hugeicons-laptop text-[34px] faint"></span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight leading-[1.1] mt-4 mb-5 mx-auto max-w-[18ch]">Your messages never leave your Mac.</h2>
      <p class="soft text-lg leading-relaxed m-0 mx-auto max-w-[52ch]">No account, no server, no analytics. Attic reads your apps where they already are and keeps its copies in your Library folder.</p>
    </section>

    <!-- FAQ. -->
    <section id="faq" class="max-w-3xl mx-auto px-5 md:px-8 py-16 md:py-20">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight m-0 mb-8">Questions</h2>
      <div class="flex flex-col gap-3">
        @foreach (faqs as item)
          <details class="tile px-6 py-5">
            <summary class="flex items-center justify-between gap-4 font-semibold text-[17px]">
              {{ item.q }}
              <span class="chevron i-hugeicons-add-01 text-[18px] faint shrink-0"></span>
            </summary>
            <p class="soft leading-relaxed mt-3 mb-0">{{ item.a }}</p>
          </details>
        @endforeach
      </div>
    </section>

    <!-- The one call to action, once more at the end. -->
    <section class="max-w-6xl mx-auto px-5 md:px-8 pb-20 md:pb-28">
      <div class="rounded-[28px] px-6 py-14 md:py-16 text-center" style="background: var(--accent-wash)">
        <img src="/images/app-icon.png" alt="" width="84" height="84" class="mx-auto block mb-5">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight m-0 mb-3">Clear your chats without losing a word.</h2>
        <p class="soft m-0 mb-7">For macOS 14 Sonoma and later.</p>
        <a href="{{ download }}" class="btn btn-primary"><span class="i-hugeicons-apple text-[18px]"></span>Get Attic</a>
      </div>
    </section>
  </main>

  <footer class="max-w-6xl mx-auto px-5 md:px-8 py-10 flex flex-col sm:flex-row gap-3 justify-between text-[13px] faint" style="border-top: 1px solid var(--line)">
    <span>© {{ year }} Attic. Built with Stacks.</span>
    <span>iMessage, WhatsApp, Slack and Discord are trademarks of their owners.</span>
  </footer>
</body>
</html>
