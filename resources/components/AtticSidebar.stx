<script client>
const sections = useReactiveProp('sections', [])
const selected = useReactiveProp('selected', 'all')
const fixture = useReactiveProp('fixture', false)
const emit = defineEmits(['choose', 'settings'])
</script>
<View class="w-[212px] shrink-0 flex-col border-r" style="border-color: separator" material="sidebar">
  <NativeSidebar class="flex-1" :sections="sections()" :selected="selected()" @change="emit('choose', $event.nativeEvent.value)" testID="mailboxes" />
  <View class="gap-2 px-3 pb-3">
    <Text :if="fixture()" class="text-[10px] px-1" style="color: secondaryLabel" :text="'Sample conversations'" />
    <Button title="Settings…" symbol="gearshape" variant="ghost" class="h-[30px] text-left" style="color: secondaryLabel" @click="emit('settings')" accessibilityLabel="Open Settings" />
  </View>
</View>
