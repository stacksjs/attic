<script client>
const draft = useModel('draft', { default: '' })
const enabled = useReactiveProp('enabled', false)
const canOpen = useReactiveProp('canOpen', false)
const busy = useReactiveProp('busy', false)
const provider = useReactiveProp('provider', '')
const reply = useReactiveProp('reply', null)
const files = useReactiveProp('files', [])
const emit = defineEmits(['send', 'attach', 'open', 'cancel-reply', 'remove-file'])
</script>
<View class="gap-2 px-4 pt-2 pb-3 shrink-0" testID="composer-area">
  <View :if="reply()" class="flex-row items-center gap-2 px-3 py-1 rounded-[9px]" style="background-color: controlBackground">
    <Text class="flex-1 text-[11px]" :numberOfLines="1" :text="`Replying to: ${reply()?.text || 'Attachment'}`" />
    <ToolbarButton label="Cancel reply" symbol="xmark" @click="emit('cancel-reply')" />
  </View>
  <View :if="files().length" class="flex-row gap-2">
    <Button :for="file in files()" :key="file.path" :title="`Remove ${file.name}`" symbol="xmark.circle" variant="ghost" @click="emit('remove-file', file)" />
  </View>
  <View :if="enabled()" class="flex-row gap-2 items-center">
    <ToolbarButton label="Attach a file" symbol="plus.circle" @click="emit('attach')" testID="attach" />
    <View class="flex-1 rounded-[17px] border" style="border-color: separator">
      <TextInput class="h-[34px] text-[13px]" :multiline="true" :bordered="false" :placeholder="provider() === 'imessage' ? 'iMessage' : 'Message'" x-model="draft" @submit="emit('send')" testID="composer" />
    </View>
    <ToolbarButton label="Send" symbol="arrow.up.circle.fill" class="text-[25px]" :disabled="busy() || (!draft().trim() && !files().length)" @click="emit('send')" testID="send" />
  </View>
  <Button :if="!enabled()" title="Reply in App" symbol="arrow.up.forward.app" variant="ghost" :disabled="!canOpen()" @click="emit('open')" />
</View>
