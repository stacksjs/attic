<script server>
import pkg from '../../package.json'

const source = 'https://github.com/stacksjs/attic'
const releases = 'https://github.com/stacksjs/attic-downloads/releases/latest'
const download = `https://github.com/stacksjs/attic-downloads/releases/download/v${pkg.version}/Chatfold-${pkg.version}.dmg`

const channels = [
  { name: 'Messages', icon: 'i-hugeicons-message-01' },
  { name: 'WhatsApp', icon: 'i-hugeicons-whatsapp' },
  { name: 'Slack', icon: 'i-hugeicons-slack' },
  { name: 'Discord', icon: 'i-hugeicons-discord' },
]

const faqs = [
  { question: 'Where is my archive stored?', answer: 'Chatfold stores its archive on your Mac. If you set up phone sync, Chatfold can share your conversations with a paired device.' },
  { question: 'What happens when I archive a chat?', answer: 'Chatfold saves a local copy and moves the chat to its archive. Depending on the service and conversation, it can also archive, close, or remove the thread in the original app. Chatfold shows what it can do before you archive.' },
  { question: 'Can I move an archived chat back?', answer: 'You can bring a conversation back to your Chatfold inbox. Recovery in the original app depends on the service. For example, Messages recovery is available while the thread is in Recently Deleted.' },
  { question: 'Why does Chatfold ask for macOS permissions?', answer: 'Reading the local Messages history requires Full Disk Access. Chatfold asks for Accessibility when it needs to perform an action for you in an app such as Messages or WhatsApp.' },
  { question: 'How do updates work?', answer: 'Open Software Update in Settings to check any time. If you already use Attic, the same updater installs Chatfold with your existing archive.' },
]
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Chatfold | A Mac inbox and archive for your chats</title>
  <meta name="description" content="Chatfold brings Messages, WhatsApp, Slack, and Discord together in one Mac inbox with a searchable local archive.">
  <meta property="og:title" content="Chatfold | A Mac inbox and archive for your chats">
  <meta property="og:description" content="Your chats, one inbox. Chatfold keeps a searchable archive on your Mac.">
  <meta property="og:site_name" content="Chatfold">
  <meta property="og:url" content="https://chatfold.stacksjs.com/">
  <meta property="og:image" content="https://chatfold.stacksjs.com/images/screens/attic-inbox-light.webp">
  <link rel="canonical" href="https://chatfold.stacksjs.com/">
  <link rel="icon" href="/images/app-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&amp;display=swap">
  <style>
    :root {
      color-scheme: light dark;
      --paper: #f8f9ff;
      --ink: #161a2c;
      --muted: #505873;
      --line: #dce0ef;
      --accent: #423abc;
      --action: #4439be;
      --action-hover: #342b9d;
      --action-ink: #ffffff;
      --panel: #edf0fb;
      --shadow: #212e5829;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #17192a;
        --ink: #f5f6ff;
        --muted: #b9bed9;
        --line: #363953;
        --accent: #b3adff;
        --action: #b8b1ff;
        --action-hover: #c9c5ff;
        --action-ink: #1b1647;
        --panel: #222541;
        --shadow: #0007;
      }
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-padding-top: 1.25rem; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1rem/1.6 'Geist', system-ui, sans-serif; }
    a { color: inherit; text-underline-offset: .25em; }
    a, summary { -webkit-tap-highlight-color: transparent; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: .25rem; }
    img { display: block; max-width: 100%; height: auto; }
    h1, h2, h3, p, figure { margin: 0; }
    .wrap { width: min(78rem, calc(100% - clamp(2rem, 8vw, 9rem))); margin-inline: auto; }
    .skip { position: absolute; top: .75rem; left: .75rem; padding: .6rem 1rem; background: var(--paper); z-index: 2; transform: translateY(-200%); }
    .skip:focus { transform: translateY(0); }
    .header { min-height: 4.5rem; padding-block: .75rem; border-bottom: 1px solid var(--line); }
    .brand { color: var(--ink); font-weight: 650; letter-spacing: -.04em; font-size: 1.2rem; text-decoration: none; white-space: nowrap; }
    .brand img { border-radius: .45rem; }
    .nav { gap: clamp(.85rem, 3vw, 2.25rem); }
    .nav a, .footer a { color: var(--muted); font-size: .875rem; font-weight: 500; text-decoration: none; }
    .nav a:hover, .footer a:hover { color: var(--ink); text-decoration: underline; }
    .hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.3fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding-block: clamp(3.25rem, 6.5vw, 6rem); }
    .display { font-weight: 650; letter-spacing: -.075em; text-wrap: balance; }
    h1.display { font-size: clamp(2.45rem, 5vw, 4.55rem); line-height: 1.02; }
    h1 span { display: block; color: var(--accent); }
    h2.display { font-size: clamp(2.35rem, 4.4vw, 4rem); line-height: 1.07; }
    .intro { margin-top: 1.25rem; max-width: 38ch; color: var(--muted); font-size: clamp(1rem, 1.35vw, 1.16rem); }
    .actions { margin-top: 1.85rem; }
    .download { min-height: 3rem; padding: .65rem 1.05rem; border-radius: .55rem; color: var(--action-ink); background: var(--action); font-size: .925rem; font-weight: 650; text-decoration: none; }
    .download:hover { background: var(--action-hover); }
    .download-mark { width: 1rem; height: 1rem; }
    .system { color: var(--muted); margin-top: .62rem; font-size: .8rem; }
    .frame { background: var(--panel); border: 1px solid var(--line); border-radius: .95rem; padding: clamp(.55rem, 1.45vw, 1.25rem); }
    .frame img { width: 100%; border-radius: .55rem; box-shadow: 0 .65rem 1.75rem var(--shadow); }
    .section { border-top: 1px solid var(--line); padding-block: clamp(2.75rem, 5.5vw, 5rem); }
    .channels { display: flex; flex-wrap: wrap; gap: .55rem 1.15rem; margin: 1.35rem 0 0; padding: 0; list-style: none; }
    .channels li { color: var(--muted); font-size: .82rem; font-weight: 500; }
    .source-icon { display: inline-block; width: .95rem; height: .95rem; color: var(--ink); }
    .workflow { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(1.75rem, 6vw, 6rem); align-items: center; }
    .workflow p { color: var(--muted); margin-top: 1rem; max-width: 37ch; }
    .faq { display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1.4fr); gap: clamp(1.25rem, 6vw, 6rem); }
    details { border-top: 1px solid var(--line); padding-block: .85rem; }
    details:last-child { border-bottom: 1px solid var(--line); }
    summary { cursor: pointer; list-style: none; font-weight: 600; padding-block: .2rem; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: ''; width: .45rem; height: .45rem; margin: .1rem .3rem .3rem .5rem; flex-shrink: 0; border: solid var(--accent); border-width: 0 1px 1px 0; transform: rotate(45deg); }
    details[open] summary::after { transform: rotate(225deg); }
    details p { margin-top: .35rem; color: var(--muted); padding-right: 1.55rem; padding-bottom: .25rem; max-width: 63ch; }
    .footer { border-top: 1px solid var(--line); padding-block: 1.4rem 1.65rem; row-gap: .75rem; }
    .footer .brand { color: var(--ink); font-size: 1rem; }
    @media (max-width: 56rem) {
      .hero { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
      .workflow { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 44rem) {
      .hero, .workflow, .faq { grid-template-columns: minmax(0, 1fr); }
      h1.display { font-size: clamp(2.5rem, 12.5vw, 3.6rem); }
      .workflow .frame { order: 1; }
      .header { min-height: 4.4rem; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .download { transition: background-color 160ms ease-out; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="flex gap-4 items-center justify-between header wrap">
    <a class="inline-flex gap-2 items-center brand" href="/">
      <img src="/images/app-icon.png" alt="" width="34" height="34">
      Chatfold
    </a>
    <nav class="flex items-center nav" aria-label="Main navigation">
      <a href="#features">Archive</a>
      <a href="#faq">FAQ</a>
    </nav>
  </header>

  <main id="main" class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title" class="display">Your chats, <span>one inbox.</span></h1>
        <p class="intro">Read and organize your messages in one Mac app. Keep a searchable archive on your device.</p>
        <ul class="channels" aria-label="Supported sources">
          @foreach (channels as channel)
            <li class="flex gap-1.5 items-center"><span class="source-icon {{ channel.icon }}" aria-hidden="true"></span>{{ channel.name }}</li>
          @endforeach
        </ul>
        <div class="actions">
          <a class="inline-flex gap-2 items-center download" href="{{ download }}">
            <span class="download-mark i-hugeicons-download-01" aria-hidden="true"></span> Download for Mac
          </a>
          <p class="system">For Macs with Apple silicon</p>
        </div>
      </div>

      <figure class="frame">
        <picture>
          <source srcset="/images/screens/attic-inbox-dark.webp" media="(prefers-color-scheme: dark)">
          <img src="/images/screens/attic-inbox-light.webp" alt="Chatfold's Mac inbox showing sample conversations and an open message thread" width="1760" height="1163" fetchpriority="high">
        </picture>
      </figure>
    </section>

    <section id="features" class="section workflow" aria-labelledby="archive-title">
      <figure class="frame">
        <picture>
          <source srcset="/images/screens/attic-find-dark.webp" media="(prefers-color-scheme: dark)">
          <img src="/images/screens/attic-find-light.webp" alt="Chatfold showing search results from an archived sample conversation" width="1760" height="1163" loading="lazy">
        </picture>
      </figure>
      <div>
        <h2 id="archive-title" class="display">Archive now.<br>Find it later.</h2>
        <p>File away quiet conversations. Search their history whenever you need a detail, even if you’ve forgotten which app it came from.</p>
        <p>When someone writes again, choose whether the conversation returns to your inbox or stays archived.</p>
      </div>
    </section>

    <section id="faq" class="faq section" aria-labelledby="faq-title">
      <h2 id="faq-title" class="display">Questions</h2>
      <div>
        @foreach (faqs as faq)
          <details>
            <summary class="flex items-center justify-between">{{ faq.question }}</summary>
            <p>{{ faq.answer }}</p>
          </details>
        @endforeach
      </div>
    </section>
  </main>

  <footer class="flex flex-wrap gap-4 items-center justify-between footer wrap">
    <a class="inline-flex gap-2 items-center brand" href="/">
      <img src="/images/app-icon.png" alt="" width="28" height="28" loading="lazy">
      Chatfold
    </a>
    <div class="flex flex-wrap items-center nav">
      <a href="{{ releases }}">Releases</a>
      <a href="{{ source }}">Source on GitHub</a>
    </div>
  </footer>
</body>
</html>
